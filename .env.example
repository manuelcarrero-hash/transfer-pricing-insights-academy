# Browser-visible configuration only.
# IMPORTANT: every VITE_* value is bundled into client code and must be treated as public.

# Added only when VS-2 introduces Supabase.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NEVER place secret/backend credentials in this file with a VITE_ prefix.
# Forbidden in browser code:
# SUPABASE_SECRET_KEYS
# SUPABASE_SERVICE_ROLE_KEY
# sb_secret_...
