{
  "name": "transfer-pricing-insights-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo-static.mjs",
    "typecheck": "tsc -b --pretty false",
    "security:client": "node scripts/check-client-secrets.mjs",
    "curriculum:check": "node scripts/check-curriculum-integrity.mjs",
    "path:check": "node scripts/check-learning-path-integrity.mjs",
    "polish:check": "node scripts/check-frontend-polish-integrity.mjs",
    "seo:check": "node scripts/check-seo-output.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
